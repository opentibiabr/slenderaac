@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

html,
body {
	@apply min-h-[100vh];
}

@font-face {
	font-family: 'Quicksand';
	src: url('/fonts/Quicksand.ttf');
	font-display: swap;
}

@font-face {
	/* Reference name */
	font-family: 'Inter';
	/* For multiple files use commas, ex: url(), url(), ... */
	src: url('/fonts/Inter-VariableFont_slnt,wght.ttf');
}

.main-content {
	@apply relative z-0;
}

.layout-surface-cards .layout-surface-cards-content {
	@apply relative z-10 m-auto overflow-auto max-w-6xl;
}

.layout-surface-cards .layout-surface-cards-background {
	@apply fixed inset-0 z-0 pointer-events-none;
	@apply bg-cover md:bg-[100%] bg-fixed bg-no-repeat bg-top;
	background-image:
		url('/images/background-artwork.jpg'),
		radial-gradient(
			at 0% 0%,
			rgb(var(--color-tertiary-500)) 0px,
			transparent 100%
		),
		radial-gradient(
			at 98% 1%,
			rgb(var(--color-surface-800)) 0px,
			transparent 100%
		),
		linear-gradient(
			0deg,
			rgba(var(--color-tertiary-900) / 0.9) 0px,
			transparent 100%
		);
}

.layout-surface-cards .layout-surface-cards-backdrop {
	@apply fixed inset-0 z-0 pointer-events-none;
	@apply w-full h-[100vh];
	@apply backdrop-brightness-150;
	@apply transition-all;
}

.dark .layout-surface-cards .layout-surface-cards-backdrop {
	@apply backdrop-brightness-50;
}

a[disabled='true'],
button[disabled='true'],
button:disabled {
	@apply opacity-50 cursor-not-allowed pointer-events-none;
}

@layer components {
	.card.card-surface {
		@apply bg-surface-300 dark:bg-surface-900;
	}

	.card.card-tertiary {
		@apply bg-tertiary-500 dark:bg-tertiary-800 text-white;
	}

	.accordion-item .accordion-control {
		@apply bg-tertiary-400 rounded-md px-2 py-1;
	}

	.accordion-panel .list-nav a {
		@apply px-4 -mx-4 py-1;
	}

	.card-tertiary .accordion-panel .list-nav a:hover {
		@apply bg-tertiary-400;
	}

	.accordion-panel {
		@apply px-0;
	}

	.input-error {
		@apply border-2 border-error-500;
	}

	.divider {
		@apply !border-t-2 !border-secondary-900/30 my-2 -mx-8 rounded-full;
	}

	.layout-surface-cards .table-container .table {
		@apply rounded-none;
	}

	.layout-surface-cards .table tbody th {
		@apply p-4;
	}

	.layout-surface-cards .table-container,
	.layout-surface-cards .data-table {
		@apply rounded-container-token;
		@apply ring-0 border-2 border-surface-600;
	}

	.layout-surface-cards .table-container .table thead {
		@apply bg-surface-500 dark:bg-surface-800;
		@apply border-surface-500 dark:border-surface-800;
	}

	.layout-surface-cards .table-container .table:not(.table-noeven) tbody,
	.layout-surface-cards .data-table {
		@apply bg-surface-400 dark:bg-surface-700;
	}

	.layout-surface-cards
		.table-container
		.table:not(.table-noeven)
		tbody
		> *:nth-child(even),
	.layout-surface-cards .data-row:nth-child(even) {
		@apply bg-surface-500 dark:bg-surface-800;
	}

	.layout-surface-cards .data-table {
		@apply flex flex-col gap-0 items-center justify-center justify-items-center;
	}
	.layout-surface-cards .data-row {
		@apply flex flex-row items-stretch w-full;
	}
	.layout-surface-cards .data-row dt,
	.layout-surface-cards .data-row dd {
		@apply p-2;
	}
	.layout-surface-cards .data-row dt {
		@apply font-bold flex-1 text-right;
	}
	.layout-surface-cards .data-row dd {
		@apply flex-1;
	}
	.layout-surface-cards .data-row:first-child {
		@apply !rounded-t-lg;
	}
	.layout-surface-cards .data-row:last-child {
		@apply !rounded-b-lg;
	}

	.placeholder {
		@apply bg-surface-400-500-token;
	}

	.list-nav a:focus,
	.list-nav button:focus,
	.list-option:focus {
		@apply text-primary-300;
	}

	:is(.dark .anchor) {
		@apply text-primary-900;
	}
}

:root {
	--svooltip-bg: rgb(var(--color-surface-900));
	--svooltip-text: rgb(var(--color-surface-100));
	--svooltip-roundness: var(--theme-rounded-container);
	--svooltip-padding: 6px 10px;
	--svooltip-weight: 400;
	--svooltip-text-size: 16px;
	--svooltip-shadow: 0 3px 7px rgb(0 0 0 / 0.25);
	--svooltip-arrow-size: 6px;
	--svooltip-index: 10;
}
