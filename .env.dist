# First installation and common commands: docs/getting-started.md
DATABASE_URL="mysql://tibia:tibia@localhost:3306/tibia"
# Recommended: the config.lua actually used by the game server. Its MySQL settings
# override DATABASE_URL for the website and package migration commands.
# DATABASE_URL is the fallback only when this path is empty. An invalid file stops
# startup; it never silently selects another database. Restart after changes.
# Relative paths resolve from the website's working directory. See docs/database.md.
SERVER_CONFIG_FILE=

PUBLIC_BASE_URL="http://localhost:5173"

PUBLIC_TITLE="Slender AAC"
# Opt-in request/phase timings and database identity in the server console.
# Disable after collecting a short diagnostic log. See docs/diagnostics.md.
SLENDER_DIAGNOSTICS=false
PUBLIC_DISCORD_URL="https://discord.gg/"
# Optional server-owned channels and trailer. Empty values hide their links.
PUBLIC_TWITCH_URL=""
PUBLIC_YOUTUBE_URL=""
PUBLIC_FACEBOOK_URL=""
PUBLIC_TRAILER_URL=""
PUBLIC_WHATSAPP_URL=""
PUBLIC_INSTAGRAM_URL=""
PUBLIC_WIKI_URL="https://wiki.example.com/"
PUBLIC_DOWNLOAD_URL="https://github.com/dudantas/tibia-client/releases"
PUBLIC_SUPPORT_EMAIL="hi@localhost"

PUBLIC_ENABLE_PRONOUNS=false

SERVER_ADDRESS="127.0.0.1"
SERVER_PORT=7172
# Public server identity used by login, navigation and page content.
SERVER_NAME="Slender"
# Optional native world and Library snapshot produced by import-server-data.
SERVER_DATA_FILE=
SERVER_LOCATION="USA"
PVP_TYPE="no-pvp"

PUBLIC_STRIPE_KEY=pk_test_...
SECRET_STRIPE_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=

ENABLE_STRIPE_CUSTOM=true
ENABLE_STRIPE_CHECKOUT=true

NO_REPLY_EMAIL="SlenderAAC (no-reply) <no-reply@localhost>"
SMTP_SERVER=smtp-relay.sendinblue.com
SMTP_PORT=587
SMTP_USER=your-user
SMTP_PASSWORD=your-password
EMAIL_BACKGROUND_COLOR="#eee6d9"
EMAIL_BUTTON_COLOR="#0010cd"
EMAIL_BUTTON_TEXT="#f4ca41"

AUTO_ADMIN_EMAIL="admin@localhost"
REQUIRE_EMAIL_CONFIRMATION_TO_LOGIN=false

# If you have an existing database with passwords hashed with SHA1, set this to true
# New passwords will be hashed with bcrypt, but old passwords will still be able to log in
ALLOW_LEGACY_SHA1_PASSWORDS=true

# If you can't use a version of Canary that supports sessions, set this to true
DEPRECATED_USE_SHA1_PASSWORDS=false

GAME_SESSION_EXPIRATION_TIME=24h

MINIMOUM_GUILD_LEVEL=8

FREE_PREMIUM=true
PUBLIC_TUTORIAL_ENABLED=false

SERVER_SAVE_TIME=00:00:00

PUBLIC_THEME=legbone
SLENDER_THEME=legbone
# Show the layout menu and allow per-browser selection. Set false to enforce SLENDER_THEME.
SLENDER_THEME_SWITCHER_ENABLED=true
THEME_ASSETS_ROOT=
OUTFIT_ASSETS_ROOT=
ITEM_ASSETS_ROOT=
STORE_ASSETS_ROOT=
# Absolute path to the operator-published artwork ZIP served at /fankit/download.
FANKIT_FILE=
# Absolute directory containing the operator soundtrack manifest and media.
SOUNDTRACK_ASSETS_ROOT=
# Absolute directory containing the operator map manifest and media.
MAP_ASSETS_ROOT=
